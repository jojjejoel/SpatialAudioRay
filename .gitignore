# Build output. The hosting project's .gitignore covers these while the plugin
# sits inside it; this file is what protects the plugin as a standalone repo.
Binaries/
Intermediate/
Saved/

# VoiceGen: generated banks, exports and local venv are not reproducible inputs.
# refs/*.wav ARE tracked - they are the voice cloning references and cannot be regenerated.
Tools/VoiceGen/out*/
Tools/VoiceGen/export*/
Tools/VoiceGen/.venv/
__pycache__/

# Generated voice bank. Reproducible from Tools/VoiceGen: refs, lines CSV and
# generate_bank.py are all tracked, so the renders are build output.
Content/Voice/

# Tuning is project-specific; consumers create their own settings asset.
Content/DA_SpatialAudio.uasset
